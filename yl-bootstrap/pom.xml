<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.yl</groupId>
        <artifactId>yl-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>yl-bootstrap</artifactId>
    <name>yl-bootstrap</name>
    <description>启动模块：装配全部模块，产出可执行 fat jar</description>

    <dependencies>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-infrastructure</artifactId>
        </dependency>

        <!-- 业务域 -->
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-account</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-evaluation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-archive</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-care</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-supervise</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-report</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>yl-bootstrap</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            DB 级集成门禁 profile（闭环 D5-R1）。

            默认 surefire includes = **/*Test.java，故 *IT.java（如 RetentionChainDbIT）不进默认 `mvn verify`
            ——既有 270/0 基线不受影响。仅当显式 `-P db-it` 时把 includes 收窄为 **/*IT.java，只跑 DB 级集成测试。
            便捷入口：`bash scripts/verify-retention-chain.sh`（需 MySQL/Redis 在跑）。
        -->
        <profile>
            <id>db-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <!--
                            显式固定版本以消除 “plugin.version is missing” WARNING（根 POM 无 pluginManagement）。
                            3.5.4 = 本机 Maven 3.9.16 超 POM 的默认值，故与默认构建**同版本、零行为变更**；
                            如升级 Maven / 需要统一版本，请同步修改此处。
                        -->
                        <version>3.5.4</version>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

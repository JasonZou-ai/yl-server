<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.yl</groupId>
        <artifactId>yl-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>yl-bootstrap</artifactId>
    <name>yl-bootstrap</name>
    <description>启动模块：装配全部模块，产出可执行 fat jar</description>

    <dependencies>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-infrastructure</artifactId>
        </dependency>

        <!-- 业务域 -->
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-account</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-evaluation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-archive</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-care</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-supervise</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.yl</groupId>
            <artifactId>yl-module-report</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>yl-bootstrap</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
